# Database (PostgreSQL — gunakan connection string dari hosting DB, mis. Render Postgres)
DATABASE_URL="postgresql://user:password@host:5432/kopispot?schema=public"

# Auth
JWT_SECRET="generate-with: openssl rand -base64 32"
JWT_EXPIRES_IN="7d"

# API
PORT=4000
CLIENT_ORIGIN="http://localhost:8443"

MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=your-server-key
MIDTRANS_CLIENT_KEY=your-client-key

# Untuk testing sandbox Midtrans, gunakan mode production false.
# Setelah berhasil, ganti ke true untuk produksi.