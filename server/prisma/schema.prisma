generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  BUSINESS_OWNER
}

enum PlaceCategory {
  SPECIALTY
  LOCAL
  INTERNATIONAL
  INSTAGRAMABLE
  STUDY_SPACE
  HIDDEN_GEM
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  PREPARING
  READY
  SHIPPED
  COMPLETED
  CANCELLED
  EXPIRED
  PAYMENT_FAILED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  UNPAID
  PAID
  FAILED
}

model User {
  id            String   @id @default(cuid())
  name          String?
  username      String?  @unique
  email         String   @unique
  password      String
  role          Role     @default(USER)
  bio           String?
  image         String?
  xp            Int      @default(0)
  level         Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  places         Place[]
  ratings        Rating[]
  comments       Comment[]
  orders         Order[]
  reservations   Reservation[]
  placeViews     PlaceView[]
  posts          Post[]
  postComments   PostComment[]
  postLikes      PostLike[]
  savedPosts     SavedPost[]
  achievements   UserAchievement[]
  productReviews ProductReview[]

  @@map("users")
}

model Place {
  id          String        @id @default(cuid())
  name        String
  category    PlaceCategory
  description String
  address     String
  city        String
  price       String
  openHours   String
  imageUrl    String
  tagsJson    String        @default("[]")
  imagesJson  String        @default("[]")
  wifi        Boolean       @default(true)
  cozy        Boolean       @default(true)
  authorId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ratings      Rating[]
  comments     Comment[]
  menuItems    MenuItem[]
  reservations Reservation[]
  views        PlaceView[]
  orders       Order[]
  posts        Post[]
  productReviews ProductReview[]

  @@index([category])
  @@map("places")
}

model Post {
  id          String   @id @default(cuid())
  caption     String
  placeId     String?
  category    String   @default("UMUM")
  tagsJson    String   @default("[]")
  imagesJson  String   @default("[]")
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  place    Place?        @relation(fields: [placeId], references: [id], onDelete: SetNull)
  comments PostComment[]
  likes    PostLike[]
  saves    SavedPost[]

  @@index([authorId])
  @@index([placeId])
  @@map("posts")
}

model PostComment {
  id        String   @id @default(cuid())
  body      String
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_comments")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("saved_posts")
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  icon        String   @default("")
  xpReward    Int      @default(0)

  achievements UserAchievement[]

  @@map("badges")
}

model UserAchievement {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_achievements")
}

model Rating {
  id        String   @id @default(cuid())
  value     Int
  userId    String
  placeId   String
  orderId   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId])
  @@map("ratings")
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  rating    Int?
  imageUrl  String?
  userId    String
  placeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("comments")
}

model PlaceView {
  id        String   @id @default(cuid())
  placeId   String
  userId    String?
  createdAt DateTime @default(now())

  place Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([placeId])
  @@map("place_views")
}

model MenuItem {
  id          String   @id @default(cuid())
  placeId     String
  name        String
  price       Int
  description String?
  calories    Int?
  sugar       Int?
  ingredients String?
  category    String
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  place      Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  productReviews ProductReview[]

  @@index([placeId])
  @@map("menu_items")
}

model Order {
  id            String        @id @default(cuid())
  userId        String?
  placeId       String
  guestToken    String?
  checkoutSessionId String?   @unique
  midtransOrderId String?     @unique
  midtransSnapToken String?
  midtransRedirectUrl String?
  midtransTransactionStatus String?
  status           OrderStatus   @default(PENDING_PAYMENT)
  total            Int
  note             String?
  billingAddress   String?
  paymentMethod    String?
  paymentProofUrl  String?
  paymentTransactionId String? @unique
  paymentStatus    PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  place Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  items OrderItem[]
  ratings Rating[]
  productReviews ProductReview[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Int

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  productReview ProductReview?

  @@map("order_items")
}

model Reservation {
  id        String             @id @default(cuid())
  userId    String
  placeId   String
  date      DateTime
  partySize Int
  note      String?
  status    ReservationStatus  @default(PENDING)
  createdAt DateTime           @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("reservations")
}

model ProductReview {
  id          String   @id @default(cuid())
  userId      String
  orderId     String
  orderItemId String   @unique
  menuItemId  String
  placeId     String
  rating      Int
  comment     String?
  imagesJson  String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([menuItemId])
  @@index([placeId])
  @@map("product_reviews")
}
